# Thematic instance this deployment serves: one of app/instances (industria)
NUXT_PUBLIC_INSTANCE_NAME=industria

# Notion tables where responses and emails are saved. The token of an internal
# integration with access to both, and each table's *data source* id
# (database ⋯ menu → Manage data sources → Copy data source ID). The columns
# are created on the first save.
NUXT_NOTION_API_KEY=
# Answers, one table per deployment (instance)
NUXT_NOTION_DATA_SOURCE_ID=
# Emails left on the thanks screen, kept apart so they can't be matched to the
# answers. Can be shared by several deployments (it has an instance column).
NUXT_NOTION_EMAILS_DATA_SOURCE_ID=

# Testing only: let the survey run even if responses can't be saved (nothing
# is recorded then). Otherwise the intro shows an error and can't be started.
# NUXT_NOTION_OPTIONAL=true
